{
  "name": "parrot",
  "private": true,
  "version": "0.1.0",
  "description": "Parrot — the dubbing agent that earns its own money. UBC 26 hackathon.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck",
    "db:push": "npm run db:push -w @parrot/backend",
    "db:seed": "npm run db:seed -w @parrot/backend",
    "dev:backend": "npm run dev -w @parrot/backend",
    "dev:web": "npm run dev -w @parrot/web",
    "dev:agents": "npm run dev -w @parrot/agents",
    "dev:xclone": "npm run dev -w @parrot/x-clone",
    "build:extension": "npm run build -w @parrot/extension",
    "watch:extension": "npm run watch -w @parrot/extension",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
