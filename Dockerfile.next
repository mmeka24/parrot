# Parrot Next.js front ends (web, x-clone) for Fly.io. Build context is the repo root.
#   fly deploy -c fly.web.toml
#   fly deploy -c fly.chirp.toml
FROM node:22-slim

ARG APP=web
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# they are build arguments, not runtime environment.
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
# Read by next.config.ts at build time: where /api and /media are proxied to.
ARG BACKEND_ORIGIN
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    BACKEND_ORIGIN=$BACKEND_ORIGIN \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/${APP}/package.json apps/${APP}/package.json
RUN npm ci --include-workspace-root -w @parrot/shared -w @parrot/${APP}

COPY packages/shared packages/shared
COPY apps/${APP} apps/${APP}
RUN npm run build -w @parrot/${APP}

ENV NODE_ENV=production \
    APP=${APP}
EXPOSE 8080
CMD ["sh", "-c", "cd apps/$APP && exec npx next start --port 8080 --hostname 0.0.0.0"]
