{
  "manifest_version": 3,
  "name": "Parrot",
  "version": "0.1.0",
  "description": "Dubs for the videos in your timeline. Parrot tries your video in several languages, learns which ones get watched, and you only pay for the views.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Parrot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.trycloudflare.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.trycloudflare.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
