# =============================================================================
# Parrot - environment configuration
#
# Copy to .env and fill in. NEVER commit .env. Every secret here is a TESTNET
# secret: no mainnet key belongs in this file, ever.
#
#   cp .env.example .env
#
# The app boots without most of these: anything missing falls back to a mock
# adapter and says so loudly in the UI and in the logs. Only DATABASE_URL is
# required to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
# Postgres. With the bundled docker-compose this is already correct.
DATABASE_URL=postgres://parrot:parrot@localhost:5432/parrot
BACKEND_PORT=8787
PUBLIC_WEB_URL=http://localhost:3100
PUBLIC_BACKEND_URL=http://localhost:8787
# Chirp, the local stand-in for X (apps/x-clone). Permalinks are built on it.
PUBLIC_XCLONE_URL=http://localhost:3200

# Demo mode compresses the 24h learning loop to ~1 minute, speeds up settlement
# cadence, and enables the simulated-traffic controls. Always TRUE for judging.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Arc testnet (EVM)
#
# Chain ID 5042002. USDC is BOTH the gas token (18 decimals natively) and an
# ERC-20 at 0x3600...0000 (6 decimals). See packages/shared/src/units.ts.
# Fund every address below from https://faucet.circle.com
# -----------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional: a QuickNode Arc testnet endpoint, used in preference to the public RPC.
QUICKNODE_ARC_RPC_URL=

# Revenue wallet: the x402 seller address that viewer unlocks are paid to.
# Needs native gas USDC to withdraw from Gateway and to send settlements.
PARROT_REVENUE_PRIVATE_KEY=0x
# Treasury that pays creators their claimed earnings.
PARROT_TREASURY_PRIVATE_KEY=0x

# Agent personas. Each is an independent economic actor with its own wallet.
AGENT_MAGPIE_PRIVATE_KEY=0x
AGENT_KESTREL_PRIVATE_KEY=0x
AGENT_FINCH_PRIVATE_KEY=0x

# Test-mode pooled viewer buyer wallet.
# Gateway batching requires EOA signatures (no ERC-1271 / smart-contract
# wallets), so in test mode all viewer unlocks are signed by this single
# custodial key while each viewer's balance is tracked in our ledger. This is
# documented as custodial + pooled in the README; it is not how a real
# deployment would work.
VIEWER_POOL_PRIVATE_KEY=0x

# Where the mirrored (off-chain) ElevenLabs dubbing cost is sent on-chain so the
# spend is visible on the dashboard. Leave blank to record it as a ledger debit
# only. See README "money flows".
COST_SINK_ADDRESS=
# ParrotSplitter contract, from `npm run deploy:splitter -w @parrot/backend`.
# Set it to split unlocks on-chain and record each agent auction on Arc.
SPLITTER_ADDRESS=

# -----------------------------------------------------------------------------
# Circle Gateway Nanopayments (x402)
#
# GOTCHA: @circle-fin/x402-batching DEFAULTS TO MAINNET. The testnet URL below
# must be passed explicitly or payments silently target mainnet.
# -----------------------------------------------------------------------------
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Fallback path: Circle's per-payment Facilitator Service, which settles each
# payment on-chain instead of batching. Used only if Gateway is unavailable.
CIRCLE_FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402
# One of: gateway | facilitator
PAYMENT_MODE=gateway

# Optional. Only needed if we use Circle Wallets rather than raw keys.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# -----------------------------------------------------------------------------
# ElevenLabs (dubbing + the QC language gate)
#
# Pricing, per minute of source, per target language (checked 2026-11-15):
#   dubbing v1 watermarked $0.33 | v1 clean $0.50 | v2 $2.20
# We buy v1: it is the only tier whose API returns a muxed A/V byte stream, and
# it keeps a 2-cent unlock economy viable.
# Self-serve plans allow 3 concurrent dubbing jobs.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3

# -----------------------------------------------------------------------------
# X / Twitter
#
# X API v2 is now prepaid credits, not tiers. Note the pricing trap: posting a
# reply that CONTAINS A URL costs $0.200 versus $0.015 without one, and our bot
# replies are all links. Leave X_ENABLED=false to run entirely on the mock
# adapter, which is the default and is what the demo uses.
# -----------------------------------------------------------------------------
X_ENABLED=false
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=parrot

# -----------------------------------------------------------------------------
# xAI Grok (parses a mention into a structured job)
#
# grok-4-fast / grok-3-mini were RETIRED 2026-05-15 and silently redirect to
# grok-4.3 at full price. Do not reintroduce them.
# -----------------------------------------------------------------------------
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

# -----------------------------------------------------------------------------
# QuickNode Streams (the live P&L feed)
#
# Arc blocks are sub-second, so a tip-following stream needs
# dataset_batch_size >= 5 or the API returns 422. Network slug: arc-testnet.
# -----------------------------------------------------------------------------
QUICKNODE_API_KEY=
# Shared secret from the Stream's dashboard, used to verify the webhook HMAC.
QUICKNODE_STREAM_SECURITY_TOKEN=
# Public HTTPS URL of our webhook, e.g. an ngrok tunnel during development.
QUICKNODE_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Reasoning LLM (view-prediction cold starts, category bucketing)
# One of: anthropic | gemini | none
# -----------------------------------------------------------------------------
REASONING_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Media storage. Local disk by default; no cloud bucket needed for the demo.
# -----------------------------------------------------------------------------
MEDIA_STORAGE_DIR=./apps/backend/media

# -----------------------------------------------------------------------------
# Quality check (QC). The company that made a dub never checks it: ffmpeg
# measures each dub, xAI (XAI_API_KEY above) hears it and judges its meaning.
# Without both, a real dub is NOT published (fail closed).
# -----------------------------------------------------------------------------
# Path to ffmpeg; ffprobe must sit next to it. Blank = ffmpeg on PATH.
FFMPEG_PATH=
# xAI speech-to-text model used to hear dubs.
XAI_STT_MODEL=grok-voice-transcribe-2.0
